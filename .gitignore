dist/
out/
release/
build/
.vite/
*.tsbuildinfo

# 日志与系统文件
*.log
npm-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
desktop.ini

# 本地环境变量
.env
.env.local
.env.*.local

